# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в репозиторий не коммитится (см. .gitignore).

# DuckDNS-домен (без https:// и без завершающего слэша), например geopulse-demo.duckdns.org
DOMAIN=geopulse-demo.duckdns.org

# Резервный вход по IP: блок http://{$FALLBACK_IP} в Caddyfile, значение — IP сервера.
# Опционально: при пустом значении конфиг остаётся валидным, но блок превращается
# в catch-all на порту 80 (обслуживает любой Host). Пример: FALLBACK_IP=45.12.4.88
FALLBACK_IP=45.12.4.88

# Владелец образов на GitHub (имя пользователя/организации). По умолчанию azamat-davletbaev.
OWNER=azamat-davletbaev

# Тег образов ghcr.io: latest или короткий SHA коммита (7 символов).
# Обновляется deploy.sh при каждом релизе; вручную меняется для отката.
DOCKER_TAG=latest

# PostgreSQL
POSTGRES_DB=geopulse_core
POSTGRES_USER=geopulse
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_НАДЁЖНЫЙ_ПАРОЛЬ

# ClickHouse
CLICKHOUSE_DB=gp
CLICKHOUSE_USER=geopulse
CLICKHOUSE_PASSWORD=ЗАМЕНИТЕ_НА_НАДЁЖНЫЙ_ПАРОЛЬ
