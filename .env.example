# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в репозиторий не коммитится (см. .gitignore).

# DuckDNS-домен (без https:// и без завершающего слэша), например geopulse-demo.duckdns.org
DOMAIN=

# Владелец образов на GitHub (имя пользователя/организации). По умолчанию azamat-davletbaev.
OWNER=azamat-davletbaev

# Тег образов. По умолчанию latest; для отката можно указать короткий SHA коммита.
TAG=latest

# PostgreSQL
POSTGRES_DB=geopulse_core
POSTGRES_USER=geopulse
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_НАДЁЖНЫЙ_ПАРОЛЬ

# ClickHouse
CLICKHOUSE_DB=gp
CLICKHOUSE_USER=geopulse
CLICKHOUSE_PASSWORD=ЗАМЕНИТЕ_НА_НАДЁЖНЫЙ_ПАРОЛЬ
