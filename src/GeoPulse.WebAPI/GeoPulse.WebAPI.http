@GeoPulse_HostAddress = http://localhost:5146

GET {{GeoPulse_HostAddress}}/weatherforecast/
Accept: application/json

###

# Скважины из PostgreSQL (после импорта)
GET {{GeoPulse_HostAddress}}/api/wells
Accept: application/json

###

# Стволы скважины
GET {{GeoPulse_HostAddress}}/api/wells/1/wellbores
Accept: application/json

###

# Импорт исходных данных Volve (пакетами по 1000 записей)
POST {{GeoPulse_HostAddress}}/api/import/volve
Accept: application/json

###

# Журнал запусков импорта
GET {{GeoPulse_HostAddress}}/api/import/runs
Accept: application/json

###

# Витрина добычи (демонстрационные данные контроллера)
GET {{GeoPulse_HostAddress}}/api/production/wells
Accept: application/json
