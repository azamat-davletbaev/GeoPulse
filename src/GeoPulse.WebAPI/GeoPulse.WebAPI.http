@GeoPulse_HostAddress = http://localhost:5146

GET {{GeoPulse_HostAddress}}/weatherforecast/
Accept: application/json

###

# Скважины из PostgreSQL
GET {{GeoPulse_HostAddress}}/api/wells
Accept: application/json

###

# Витрина добычи (демонстрационные данные контроллера)
GET {{GeoPulse_HostAddress}}/api/production/wells
Accept: application/json
