# Caddyfile для GeoPulse.
# {$DOMAIN} подставляется из переменной окружения DOMAIN (задаётся в .env).
# Caddy автоматически выпускает сертификат Let's Encrypt (HTTP-01/TLS-ALPN-01);
# порты 80 и 443 должны быть открыты наружу (см. DEPLOY.md).
#
# Статический фронт и REST API раздаёт сам WebAPI (UseStaticFiles), поэтому Caddy
# просто проксирует весь трафик на webapi:5146 — поведение не меняется.
#
# Zero Downtime: при `docker compose up -d` контейнер webapi пересоздаётся — на
# несколько секунд апстрим становится недоступен (порт ещё не слушается), и без
# повторов Caddy сразу вернул бы 502. lb_try_duration — общий бюджет повторов на
# один запрос, lb_try_interval — пауза между попытками: клиент ждёт до 15 с, пока
# новый контейнер поднимется, вместо ошибки 502.

{$DOMAIN} {
	encode zstd gzip

	reverse_proxy webapi:5146 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# Резервный вход по «голому» IP: используется, если DNS/DuckDNS или сертификат
# временно недоступны. Явная схема http:// обязательна — Caddy не пытается
# выпускать сертификат на IP-адрес (Let's Encrypt такие не выдаёт) и просто
# проксирует трафик на тот же webapi. Порт 80 должен быть открыт в UFW.
http://{$FALLBACK_IP} {
	encode zstd gzip

	reverse_proxy webapi:5146 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}
